@startuml klassendiagramm_programmoberflaeche
' UML-Klassendiagramm Programmoberfläche (Pflichtenheft Teil D, Abschnitt 7.1), Stand 3.0
!pragma layout smetana
title UML-Klassendiagramm — Programmoberfläche (Komponente D), Stand 3.0
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "gui — Ansichten (FXML + Ansicht-Controller)" {
  class HauptAnsichtController {
    - ansichten : Map<Navigationsziel, Parent>
    - zeige(ziel : Navigationsziel)
  }
  enum Navigationsziel {
    UEBERSICHT
    KUNDEN
    PRODUKTE
    BELEGE
    EINSTELLUNGEN
  }
  class UebersichtAnsichtController
  class KundenAnsichtController
  class ProduktAnsichtController
  class DokumentAnsichtController
  class EinstellungenAnsichtController
  class RechnungsWizardDialog
  class FxmlLader <<Spring-Controller-Factory>>
  class HintergrundAufgaben {
    + starte(titel, ausloeser, arbeit, beiErfolg)
  }
  class Tastenkuerzel {
    + {static} binde(anker, neu, suche, aktualisiere)
  }
}

package "gui — GUI-freie Controller und Modell" {
  class StammdatenController {
    + kundenListe(suchbegriff) : List<Kunde>
    + produkteListe(suchbegriff) : List<Produkt>
  }
  class DokumentListenController {
    + gefiltert(status, suchbegriff) : List<Dokument>
    + aktionenFuer(dokument) : BelegAktionen
    + storniere(nummer, bestaetigt) : Meldung
    + markiereBezahlt(nummer, datum) : Meldung
  }
  class RechnungsWizardController {
    + weiter() : boolean
    + zurueck()
    + erzeugeZusammenfassung() : String
    + speichern() : Meldung
  }
  class RechnungsWizardModel {
    - aktuellerSchritt : WizardSchritt
    - kundenNr : String
    - positionen : List<PositionsEingabe>
    - rechnungsdatum : LocalDate
    - leistungsdatum : LocalDate
    - zahlungsziel : LocalDate
  }
  enum WizardSchritt {
    KUNDE_WAEHLEN
    POSITIONEN_ERFASSEN
    DATEN_BESTAETIGEN
    ZUSAMMENFASSUNG
    SPEICHERN
  }
  class BelegAktionen <<record>> {
    stornierbar, aenderbar, pdfExport, bezahltMarkierbar
  }
  class Meldung <<record>>
}

package "Komponenten A–C und firma" {
  interface DokumentService
  interface KundenService
  interface ProduktService
  class KennzahlenDienst
  class FirmenprofilService
}

package "gemeinsam" {
  class EreignisBus
}

HauptAnsichtController --> Navigationsziel
HauptAnsichtController ..> FxmlLader : lädt Ansichten
HauptAnsichtController o-- UebersichtAnsichtController
HauptAnsichtController o-- KundenAnsichtController
HauptAnsichtController o-- ProduktAnsichtController
HauptAnsichtController o-- DokumentAnsichtController
HauptAnsichtController o-- EinstellungenAnsichtController

KundenAnsichtController --> StammdatenController
ProduktAnsichtController --> StammdatenController
DokumentAnsichtController --> DokumentListenController
DokumentAnsichtController ..> RechnungsWizardDialog : öffnet
RechnungsWizardDialog --> RechnungsWizardController
UebersichtAnsichtController ..> KennzahlenDienst
EinstellungenAnsichtController ..> FirmenprofilService

DokumentAnsichtController ..> HintergrundAufgaben : PDF, E-Rechnung, CSV
EinstellungenAnsichtController ..> HintergrundAufgaben : Datensicherung
KundenAnsichtController ..> Tastenkuerzel
DokumentAnsichtController ..> Tastenkuerzel

StammdatenController ..> KundenService
StammdatenController ..> ProduktService
DokumentListenController ..> DokumentService
RechnungsWizardController ..> DokumentService
RechnungsWizardController ..> KundenService
RechnungsWizardController ..> ProduktService

RechnungsWizardController *-- RechnungsWizardModel
RechnungsWizardModel --> WizardSchritt
RechnungsWizardController --> Meldung
DokumentListenController --> BelegAktionen

UebersichtAnsichtController ..> EreignisBus : abonniert
KundenAnsichtController ..> EreignisBus : abonniert
ProduktAnsichtController ..> EreignisBus : abonniert
DokumentAnsichtController ..> EreignisBus : abonniert
@enduml
