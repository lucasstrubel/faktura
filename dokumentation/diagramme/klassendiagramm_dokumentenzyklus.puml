@startuml klassendiagramm_dokumentenzyklus
' UML-Klassendiagramm Dokumentenzyklus (Pflichtenheft Teil A, Abschnitt 7.1), Stand 3.0
' Layout-Engine Smetana -> kein Graphviz erforderlich.
!pragma layout smetana

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members
left to right direction

title UML-Klassendiagramm — Dokumentenzyklus (Komponente A), Stand 3.0

' ===================== Domänenmodell =====================

abstract class Dokument {
  - belegnummer : String
  - datum : LocalDate
  - kundenReferenz : String
  - kundeName : String
  - kundeAnschrift : String
  - aussteller : Firmenprofil
  - status : DokumentStatus
  - vorgaengerNr : String
  - summeNetto : BigDecimal
  - summeSteuer : BigDecimal
  - summeBrutto : BigDecimal
  + {abstract} belegtyp() : Belegtyp
  + setzePositionen(positionen : List<Dokumentposition>)
  + berechneSummen()
  + steueraufschluesselung() : List<Steuerzeile>
  + versende()
  + pruefeAenderbar()
}

class Angebot {
  - gueltigBis : LocalDate
}

class Auftragsbestaetigung {
}

class Lieferschein {
  - lieferdatum : LocalDate
}

class Rechnung {
  - leistungsdatum : LocalDate
  - zahlungsziel : LocalDate
  - storniertAm : LocalDate
  - storniertVon : String
  - bezahltAm : LocalDate
  - stornoZu : String
  + storniere(datum : LocalDate, benutzer : String)
  + markiereBezahlt(datum : LocalDate)
  + istBezahlt() : boolean
  + istStornorechnung() : boolean
}

class Dokumentposition {
  - produktReferenz : String
  - bezeichnung : String
  - menge : int
  - einzelpreisNetto : BigDecimal
  - steuersatz : BigDecimal
  - positionssummeNetto : BigDecimal
  + getPositionssummeBrutto() : BigDecimal
}

class Steuerzeile <<record>> {
  + steuersatz : BigDecimal
  + netto : BigDecimal
  + steuer : BigDecimal
}

enum DokumentStatus {
  ENTWURF
  OFFEN
  VERSENDET
  STORNIERT
}

' Vererbung der vier Belegtypen
Dokument <|-- Angebot
Dokument <|-- Auftragsbestaetigung
Dokument <|-- Lieferschein
Dokument <|-- Rechnung

' Komposition: ein Dokument besteht aus 1..* Positionen
Dokument "1" *-- "1..*" Dokumentposition : positionen
Dokument ..> Steuerzeile : je Steuersatz (F-25)
Dokument --> DokumentStatus : status
Rechnung ..> Rechnung : stornoZu (Stornorechnung, F-29)

' ===================== Service-Schicht =====================

interface DokumentService <<interface>> {
  + erstelleAngebot(...) : Angebot
  + erstelleAuftragsbestaetigung(...) : Auftragsbestaetigung
  + erstelleLieferschein(...) : Lieferschein
  + erstelleRechnung(..., leistungsdatum, zahlungsziel) : Rechnung
  + erzeugeFolgebeleg(belegnummer : String) : Dokument
  + versende(belegnummer : String)
  + storniere(rechnungsnummer : String) : Rechnung
  + markiereBezahlt(rechnungsnummer : String, datum : LocalDate)
  + exportierePdf(belegnummer : String, zielDatei : Path)
}

class StandardDokumentService <<@Service, @Transactional>> {
}

interface BelegnummernGenerator <<interface>> {
  + naechsteNummer(typ : Belegtyp, jahr : int) : String
}

class JdbcBelegnummernGenerator
class JdbcNummernkreis <<gemeinsam>> {
  + naechsterWert(bereich, jahr, startwert) : int
}

interface DokumentRepository <<interface>> {
  + speichere(dokument : Dokument) : Dokument
  + findeNachNummer(belegnummer : String) : Dokument
  + alle() : List<Dokument>
}

class JdbcDokumentRepository <<SQLite>>
class JsonDokumentRepository <<Übernahme/Sicherung>>

interface PdfExporter <<interface>> {
  + exportiere(dokument : Dokument, zielDatei : Path)
}

class PdfBoxPdfExporter
class ERechnungExport <<EN 16931>> {
  + exportiereXml(rechnung : Rechnung, zielDatei : Path)
}

class DatenGeaendertEreignis <<record>> {
  + bereich : DatenBereich
}

class EreignisBus <<gemeinsam>> {
  + abonniere(bereich, beobachter)
  + empfange(ereignis) <<AFTER_COMMIT>>
}

DokumentService <|.. StandardDokumentService
BelegnummernGenerator <|.. JdbcBelegnummernGenerator
JdbcBelegnummernGenerator ..> JdbcNummernkreis : gleiche Transaktion (GR-01)
DokumentRepository <|.. JdbcDokumentRepository
DokumentRepository <|.. JsonDokumentRepository
PdfExporter <|.. PdfBoxPdfExporter

StandardDokumentService ..> BelegnummernGenerator
StandardDokumentService ..> DokumentRepository
StandardDokumentService ..> PdfExporter
StandardDokumentService ..> DatenGeaendertEreignis : veröffentlicht
DatenGeaendertEreignis ..> EreignisBus : zugestellt nach Commit
StandardDokumentService ..> Dokument : erzeugt
ERechnungExport ..> Rechnung

' ===================== Externe Komponenten (lose Kopplung) =====================

interface KundenService <<extern (Komponente C)>> {
  + findeKunde(kundennummer : String) : Kunde
}

interface ProduktService <<extern (Komponente B)>> {
  + findeProdukt(produktnummer : String) : Produkt
}

class FirmenprofilService <<extern (firma)>> {
  + fuerBeleg(rechnung : boolean) : Firmenprofil
}

class Firmenprofil <<record, extern (firma)>>

StandardDokumentService ..> KundenService
StandardDokumentService ..> ProduktService
StandardDokumentService ..> FirmenprofilService : Pflichtprofil (F-26)
Dokument --> Firmenprofil : Snapshot (F-27)

@enduml
