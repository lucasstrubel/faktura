<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Modulansicht Produktverwaltung (D-F-03 bis F-05). -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.lucasstrubel.faktura.gui.ProduktAnsichtController">

    <top>
        <VBox>
            <VBox styleClass="ansicht-kopf">
                <Label text="Produkte" styleClass="ansicht-titel"/>
                <Label text="Produkte und Leistungen; in Belegen verwendete Produkte sind vor dem Löschen geschützt"
                       styleClass="ansicht-untertitel"/>
            </VBox>
            <HBox styleClass="werkzeugleiste" alignment="CENTER_LEFT">
                <Button text="Neues Produkt" onAction="#legeNeuAn" styleClass="accent">
                    <tooltip><Tooltip text="Neues Produkt anlegen (Strg+N)"/></tooltip>
                </Button>
                <Button fx:id="bearbeitenKnopf" text="Bearbeiten" onAction="#bearbeite">
                    <tooltip><Tooltip text="Ausgewähltes Produkt bearbeiten (oder Doppelklick)"/></tooltip>
                </Button>
                <Button fx:id="loeschenKnopf" text="Löschen" onAction="#loesche">
                    <tooltip><Tooltip text="Ausgewähltes Produkt löschen (Entf)"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button text="Als CSV…" onAction="#exportiere">
                    <tooltip><Tooltip text="Produktstammdaten als CSV-Datei exportieren"/></tooltip>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="suchfeld" prefColumnCount="22"
                           promptText="Bezeichnung oder Produktnummer…">
                    <tooltip><Tooltip text="Suche nach Bezeichnung oder Produktnummer (Strg+F)"/></tooltip>
                </TextField>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="4" styleClass="inhalt">
            <TableView fx:id="tabelle" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nummerSpalte" text="Produktnummer" prefWidth="140"/>
                    <TableColumn fx:id="bezeichnungSpalte" text="Bezeichnung" prefWidth="320"/>
                    <TableColumn fx:id="preisSpalte" text="Einzelpreis (netto)" prefWidth="150"/>
                    <TableColumn fx:id="steuersatzSpalte" text="Steuersatz" prefWidth="100"/>
                    <TableColumn fx:id="einheitSpalte" text="Einheit" prefWidth="120"/>
                </columns>
            </TableView>
            <Label fx:id="trefferAnzeige" styleClass="treffer-anzeige"/>
        </VBox>
    </center>
</BorderPane>
