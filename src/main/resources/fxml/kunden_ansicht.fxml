<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Modulansicht Kundenverwaltung (D-F-03 bis F-05). -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.lucasstrubel.faktura.gui.KundenAnsichtController">

    <top>
        <VBox>
            <VBox styleClass="ansicht-kopf">
                <Label text="Kunden" styleClass="ansicht-titel"/>
                <Label text="Kundenstammdaten; referenzierte Kunden sind vor dem Löschen geschützt"
                       styleClass="ansicht-untertitel"/>
            </VBox>
            <HBox styleClass="werkzeugleiste" alignment="CENTER_LEFT">
                <Button text="Neuer Kunde" onAction="#legeNeuAn" styleClass="accent">
                    <tooltip><Tooltip text="Neuen Kunden anlegen (Strg+N)"/></tooltip>
                </Button>
                <Button fx:id="bearbeitenKnopf" text="Bearbeiten" onAction="#bearbeite">
                    <tooltip><Tooltip text="Ausgewählten Kunden bearbeiten (oder Doppelklick)"/></tooltip>
                </Button>
                <Button fx:id="loeschenKnopf" text="Löschen" onAction="#loesche">
                    <tooltip><Tooltip text="Ausgewählten Kunden löschen (Entf)"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button text="Als CSV…" onAction="#exportiere">
                    <tooltip><Tooltip text="Kundenstammdaten als CSV-Datei exportieren"/></tooltip>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="suchfeld" prefColumnCount="22"
                           promptText="Name oder Kundennummer…">
                    <tooltip><Tooltip text="Suche nach Name oder Kundennummer (Strg+F)"/></tooltip>
                </TextField>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="4" styleClass="inhalt">
            <TableView fx:id="tabelle" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nummerSpalte" text="Kundennummer" prefWidth="140"/>
                    <TableColumn fx:id="nameSpalte" text="Name" prefWidth="280"/>
                    <TableColumn fx:id="strasseSpalte" text="Straße" prefWidth="230"/>
                    <TableColumn fx:id="plzSpalte" text="PLZ" prefWidth="90"/>
                    <TableColumn fx:id="ortSpalte" text="Ort" prefWidth="190"/>
                </columns>
            </TableView>
            <Label fx:id="trefferAnzeige" styleClass="treffer-anzeige"/>
        </VBox>
    </center>
</BorderPane>
