<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Einstellungen: Firmenprofil des Ausstellers (§ 14 UStG) und Datensicherung,
    gegliedert in Abschnittskarten statt eines einzigen langen Rasters.
-->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.lucasstrubel.faktura.gui.EinstellungenAnsichtController">

    <top>
        <VBox styleClass="ansicht-kopf">
            <Label text="Einstellungen" styleClass="ansicht-titel"/>
            <Label text="Firmenprofil für Briefkopf und Zahlungshinweis sowie Sicherung Ihrer Daten"
                   styleClass="ansicht-untertitel"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="inhalt">
            <VBox spacing="16" maxWidth="640">

                <VBox spacing="10" styleClass="abschnitt-karte">
                    <Label text="Firma" styleClass="abschnitt-titel"/>
                    <Label text="Diese Angaben erscheinen als Briefkopf auf allen Belegen. Für Rechnungen ist die Steuernummer oder die USt-IdNr. Pflicht (§ 14 UStG). Neue Belege übernehmen das Profil beim Erstellen; bereits erstellte Belege bleiben unverändert."
                           styleClass="abschnitt-hinweis" wrapText="true"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="140"/>
                            <ColumnConstraints prefWidth="360" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="nameFeld" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Straße *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="strasseFeld" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="PLZ *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="plzFeld" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Ort *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="ortFeld" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="USt-IdNr." GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="ustIdNrFeld" GridPane.rowIndex="4" GridPane.columnIndex="1"
                                   promptText="DE123456789"/>
                        <Label text="Steuernummer" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="steuernummerFeld" GridPane.rowIndex="5" GridPane.columnIndex="1"
                                   promptText="37/123/45678"/>
                        <Label text="Telefon" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="telefonFeld" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                        <Label text="E-Mail" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextField fx:id="eMailFeld" GridPane.rowIndex="7" GridPane.columnIndex="1"
                                   promptText="name@domain.de"/>
                    </GridPane>
                </VBox>

                <VBox spacing="10" styleClass="abschnitt-karte">
                    <Label text="Bankverbindung" styleClass="abschnitt-titel"/>
                    <Label text="Erscheint als Zahlungshinweis auf Rechnungen."
                           styleClass="abschnitt-hinweis" wrapText="true"/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="140"/>
                            <ColumnConstraints prefWidth="360" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="IBAN" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="ibanFeld" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   promptText="DE02 1203 0000 0000 2020 51"/>
                        <Label text="BIC" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="bicFeld" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                   promptText="BYLADEM1001"/>
                        <Label text="Bank" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="bankFeld" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Label text="* Pflichtfeld" styleClass="pflichtfeld-legende"/>
                        <Button text="Firmenprofil speichern" onAction="#speichere"
                                defaultButton="true"/>
                    </HBox>
                </VBox>

                <VBox spacing="10" styleClass="abschnitt-karte">
                    <Label text="Datensicherung" styleClass="abschnitt-titel"/>
                    <Label text="Packt die Datenbank und vorhandene JSON-Bestände in eine ZIP-Datei. Die Datenbank wird dabei als in sich geschlossener Abzug geschrieben, damit die Sicherung auch bei laufender Anwendung konsistent ist."
                           styleClass="abschnitt-hinweis" wrapText="true"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button fx:id="sicherungsKnopf" text="Datensicherung erstellen…"
                                onAction="#sichere"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
