<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests protokollieren nur auf die Konsole: Die Anwendungs-Konfiguration
     schreibt in das Datenverzeichnis des Benutzers, das ein Testlauf nicht
     berühren soll. -->
<configuration>

    <appender name="KONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="KONSOLE"/>
    </root>

</configuration>
